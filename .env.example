# Relay — environment variables
#
# Copy to `.env` and fill in only what you need. Every variable here has a
# working default except the ones marked REQUIRED, so a fresh clone runs with
# no `.env` at all.
#
# This file is the discoverable list of what the app reads. A test asserts that
# every TUTOR_* variable appears here; add new ones to both places.

# ── Database ────────────────────────────────────────────────────────────────
# Default: local SQLite (`/tmp/swift_routing.db` on Vercel, repo root locally).
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/relay

# ── Admin authentication ────────────────────────────────────────────────────
# Gates /api/import/* and /api/track/create via the X-Admin-Key header.
# Unset in dev leaves those endpoints open; production MUST set it.
# ADMIN_API_KEY=

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Disabled when SENTRY_DSN is empty. Keep the DSN in the deployment's secret
# store rather than committing it here. Performance tracing is off by default;
# set a sample rate between 0 and 1 only when you want performance data.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_SEND_DEFAULT_PII=false

# ── Frontend error monitoring (Sentry) ──────────────────────────────────────
# These are Vite build variables. The DSN is public by design; set it in the
# frontend deployment environment, not in a committed file.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend source-map upload (build-time secrets; never use VITE_ prefix).
# Set all three in Vercel so production builds upload maps and remove them from
# the public bundle. They are not required for local builds.
# SENTRY_ORG=
# SENTRY_PROJECT=relay-frontend
# SENTRY_AUTH_TOKEN=

# ── Reference-data import ───────────────────────────────────────────────────
# No default URL by design — imports fail closed rather than fetching from an
# unreviewed source.
# FEDWIRE_URL=
# FEDACH_URL=

# ── AI tutor ────────────────────────────────────────────────────────────────
# Off by default. The base install carries no provider SDK; install the extra
# with `pip install '.[ai]'` before enabling.
#
# All three of TUTOR_ENABLED, TUTOR_MODEL, and the provider key are REQUIRED
# together — the endpoint answers 503 "unconfigured" if any one is missing.

# TUTOR_ENABLED=false
# TUTOR_PROVIDER=openai
# TUTOR_MODEL=

# The provider key. Server-only: never returned by /health, OpenAPI, telemetry,
# or any frontend bundle. Name follows TUTOR_PROVIDER (openai -> OPENAI_API_KEY,
# anthropic -> ANTHROPIC_API_KEY).
# OPENAI_API_KEY=

# Retrieval and prompt budgets. Anything unparseable or non-positive falls back
# to the default shown rather than raising, so a typo cannot take the app down.
# TUTOR_MAX_RETRIEVED_DOCS=6
# TUTOR_MAX_HISTORY_TURNS=8
# TUTOR_MAX_INPUT_TOKENS=14000
# TUTOR_MAX_OUTPUT_TOKENS=1200

# Rate limiting. The in-process limiter is a single-worker local fallback only;
# multi-instance production needs the external Redis-compatible limiter,
# because in-process buckets reset on every cold start.
# TUTOR_RATE_LIMIT_REDIS_URL=
# TUTOR_RATE_LIMIT_REDIS_TOKEN=

# Hard ceiling on tutor requests per day for the WHOLE deployment. The per-caller
# rate limit above stops one client looping; it does nothing about a thousand
# clients each behaving reasonably, which is the shape an unbounded bill actually
# takes. REQUIRED in production — the app answers 503 without it. Unset locally.
# A malformed or non-positive value reads as absent, not as unlimited.
# TUTOR_DAILY_REQUEST_CEILING=5000

# How many proxies sit in front of the app. Unset (0) means X-Forwarded-For is
# ignored entirely and the socket address is used — the safe default, because
# the header is caller-controlled unless a proxy is known to rewrite it. Set it
# only when you know the number; the entry is then counted from the RIGHT.
# TUTOR_TRUSTED_PROXY_HOPS=

# Langfuse tracing. Requires `pip install '.[tracing]'`; no-ops when the package
# or key is absent.
# TUTOR_TRACING_ENABLED=false
