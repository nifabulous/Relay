# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Virtual envs
.venv/
venv/
env/

# Testing / coverage
.coverage
.pytest_cache/
htmlcov/
.tox/

# SQLite dev DB (auto-created, seeded on startup)
swift_routing.db

# OS
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Secrets / local env
.env
.env.*
# ...except the committed template, which holds only names and comments. The
# broad `.env.*` above swallows it otherwise, and a variable list nobody can
# see is the reason environment variables get discovered by grepping source.
!.env.example

# Frontend (Relay)
node_modules/
frontend/node_modules/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Generated Relay build output (regenerated by npm run build)
app/static/relay/assets/
app/static/relay/index.html

# Playwright/test output artifacts
frontend/output/
output/
.playwright-cli/
.gstack/

# Local scratch / staging archives (never publish)
_to_delete/
.ssi-autopilot-state.json

# Research sidecars may retain source-published identifiers for audit trails.
# Keep the reviewed candidate evidence tracked, but never sweep generated
# result files into a commit or workspace archive.
/scripts/ssi-autopilot/results/*
!/scripts/ssi-autopilot/results/candidates-pakistan.json

# Design-QA captures are working evidence for a single comparison run, not a
# reviewable artifact. They are megabytes of PNG and go stale the moment the
# page changes; design-qa.md records what they showed.
/artifacts/
